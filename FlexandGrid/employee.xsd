<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Root element 
    <xs:element name="employee">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="eid">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="name" type="xs:string"/>
                            <xs:element name="salary" type="xs:decimal"/>
                            <xs:element name="organization" type="xs:string"/>
                        </xs:sequence>
                        <!-- Attribute for eid -->
                        <xs:attribute name="attribute-name" type="xs:ID" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>